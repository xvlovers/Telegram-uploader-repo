# Token bot Telegram, didapat dari @BotFather
TELEGRAM_BOT_TOKEN=

# Key enkripsi token GitHub user (wajib 64 karakter hex / 32 byte). Generate dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# (opsional) path database JSON
DB_PATH=./data/db.json

# (opsional tapi disarankan) Telegram user ID yang boleh pakai bot, pisahkan dengan koma.
# Cek ID kamu lewat @userinfobot. Kosong = semua orang boleh.
ALLOWED_USER_IDS=

# (opsional) batas aman extract zip
MAX_EXTRACTED_MB=150
MAX_ZIP_ENTRIES=5000
